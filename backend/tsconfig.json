{
  "compilerOptions": {
    "baseUrl": "./", // Установите базовый URL для абсолютных путей
    "paths": {
      "@common/*": ["backend/src/common/*"] // Настройте алиас для common
    },
    "allowJs": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "experimentalDecorators": true,
    "types": [
      "webpack-env",
      "jest"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules"
  ]
}